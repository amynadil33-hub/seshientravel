# Sea Shine Travel & Tours — environment variables
# Leave all Supabase values empty to run the labelled DEMO PREVIEW (in-memory data,
# nothing is saved). Fill them in to connect a real Supabase project.

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used to insert validated
# booking requests and enquiries and to check availability.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL for SEO metadata and sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://maldivesseashine.com

# Note: while Supabase is NOT configured, /admin opens without login in a
# clearly labelled demo mode (changes live in memory and reset on restart).
# Always configure Supabase before deploying publicly.
